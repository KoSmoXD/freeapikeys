{
  "geode": "5.5.3",
  "gd": {
    "android": "2.2081"
  },
  "version": "v0.3.1",
  "id": "trajectory.autoplayer",
  "name": "Trajectory AutoPlayer (Cube Test)",
  "developer": "Community Prototype",
  "description": "Cube-mode auto-jump with a single Geode enable switch, trajectory paths and diagnostics; experimental.",
  "tags": [
    "gameplay",
    "cheat"
  ],
  "settings": {
    "lookahead": {
      "type": "float",
      "name": "Lookahead (seconds)",
      "default": 0.65,
      "min": 0.15,
      "max": 1.5
    },
    "debug-draw": {
      "type": "bool",
      "name": "Draw predicted arcs",
      "default": true
    }
  }
}
