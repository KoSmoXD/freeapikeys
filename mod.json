{
  "geode": "5.5.3",
  "gd": {
    "android": "2.2081"
  },
  "version": "v0.3.0",
  "id": "trajectory.autoplayer",
  "name": "Trajectory AutoPlayer (Cube Test)",
  "developer": "Community Prototype",
  "description": "Experimental spike-aware cube autoplayer. Shows a diagnostics HUD and predicted paths. Not a universal level solver.",
  "tags": [
    "gameplay",
    "cheat"
  ],
  "settings": {
    "enabled": {
      "type": "bool",
      "name": "Enable cube auto-jump",
      "default": false
    },
    "lookahead": {
      "type": "float",
      "name": "Lookahead (seconds)",
      "default": 0.65,
      "min": 0.15,
      "max": 1.5
    },
    "debug-draw": {
      "type": "bool",
      "name": "Draw predicted arcs",
      "default": true
    }
  }
}
